FROM nginx:alpine
RUN printf 'server {\n\
  listen 80;\n\
  location /hls/ {\n\
    alias /data/hls/;\n\
    add_header Cache-Control no-cache;\n\
    add_header Access-Control-Allow-Origin *;\n\
    types {\n\
      application/vnd.apple.mpegurl m3u8;\n\
      video/mp2t ts;\n\
    }\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
