* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

[hidden] { display: none !important; }

html, body {
  width: 100%;
  min-width: 100vw;
  height: 100%;
  min-height: 100vh;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, sans-serif;
  background: #0f0f0f;
  color: #e0e0e0;
}

#root {
  width: 100%;
  min-width: 100vw;
  height: 100%;
  min-height: 100vh;
}

.container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 24px 20px 48px;
}

/* ── Admin Shell — Matches wireframe exactly ──────────────────────────────── */
/* Based on showgather-admin-wireframes.html */
.admin-shell {
  display: grid;
  grid-template-columns: 230px 1fr 285px;
  gap: 2px;
  min-height: 0;
  overflow: hidden;
}

/* Responsive breakpoints from wireframe */
@media (max-width: 1100px) {
  .admin-shell {
    grid-template-columns: 190px minmax(0,1fr) 240px !important;
  }
}

@media (max-width: 850px) {
  .admin-shell {
    display: grid !important;
    grid-template-columns: 1fr !important;
    overflow: visible !important;
  }
}

.admin-shell__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding-bottom: 16px; border-bottom: 1px solid #2a3445; }
.admin-shell__status { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }.admin-shell__status .connection { margin: 0!important; }.diagnostics-toggle { border: 1px solid #4f5e72; border-radius: 5px; padding: 5px 8px; background: transparent; color: #b8c7da; cursor: pointer; font-size: .72rem; }
.admin-shell__brand { color: #eef7ff; font-size: 1.25rem; font-weight: 760; letter-spacing: -.02em; text-decoration: none; }.admin-shell__header p { margin: 5px 0 0; color: #8490a2; font-size: .84rem; }
.admin-shell__nav { display: flex; gap: 6px; margin: 16px 0 24px; padding: 6px; border: 1px solid #2a3445; border-radius: 9px; background: #131b28; }.admin-shell__nav button { flex: 1; padding: 9px 12px; border: 0; border-radius: 6px; background: transparent; color: #9fb0c5; cursor: pointer; text-transform: capitalize; }.admin-shell__nav button.active { background: #273d5b; color: #eff8ff; font-weight: 750; }.admin-shell__nav button:disabled { cursor: not-allowed; opacity: .45; }
.admin-context { padding: 16px; border: 1px solid #2a3445; border-radius: 10px; background: #121a26; }.admin-context .form { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }.admin-context .form select { width: 100%; }
.workspace--rehearse .admin-shell__header { border-color: #8c7028; }.workspace--rehearse .admin-shell__nav { border-color: #8c7028; background: #211d13; }.workspace--run .admin-shell__header { border-color: #8e3939; }.workspace--run .admin-shell__nav { border-color: #8e3939; background: #241619; }
.rehearsal-banner { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 16px 0; padding: 11px 13px; border: 1px solid #b78c32; border-radius: 8px; background: #2a210f; color: #ffe2a2; }.rehearsal-banner strong { letter-spacing: .07em; font-size: .78rem; }.rehearsal-banner span { color: #e6cea0; font-size: .82rem; }.rehearsal-console { border: 1px solid #8c7028; border-radius: 10px; padding: 16px; background: #1b170e; }.rehearsal-console .cue-grid button { border-color: #b78c32; background: #5b4216; color: #fff0c5; }
.rehearsal-preview { padding: 16px; border: 1px solid #8c7028; border-radius: 10px; background: #1e1a11; }.workspace-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }.profile-picker { display: flex; gap: 4px; padding: 4px; border: 1px solid #725b25; border-radius: 7px; background: #15130d; }.profile-picker button { border: 0; border-radius: 5px; padding: 6px 9px; background: transparent; color: #c6b98c; cursor: pointer; text-transform: capitalize; font-size: .78rem; }.profile-picker button.active { background: #e6bd59; color: #1d1604; font-weight: 800; }.player-preview { display: block; width: 100%; min-height: 430px; margin-top: 14px; border: 1px solid #45536a; border-radius: 8px; background: #080b12; }.player-preview--mobile { width: min(430px, 100%); margin-right: auto; margin-left: auto; }.player-preview--tv { min-height: 360px; }
.run-entry { padding: 22px; border: 1px solid #9d4040; border-radius: 12px; background: #231518; }.run-entry__summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 18px 0; }.run-entry__summary > div { padding: 12px; border: 1px solid #4b2a30; border-radius: 7px; background: #1a1114; }.run-entry__summary dt { color: #aeb9c9; font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }.run-entry__summary dd { margin: 5px 0 0; color: #f4f8ff; font-size: .9rem; }.run-entry__go { padding: 12px 20px; border: 1px solid #d65b5b; border-radius: 7px; background: #a63239; color: #fff; cursor: pointer; font-weight: 800; }.run-entry__go:disabled { cursor: not-allowed; opacity: .45; }.run-preview { padding: 16px; border: 1px solid #7b3c3c; border-radius: 10px; background: #180e11; }
.run-console { display: grid; grid-template-columns: minmax(0, 1fr) 180px; gap: 16px; padding: 20px; border: 1px solid #80363b; border-radius: 12px; background: #1a1013; }.run-console__cue { padding: 18px; border-radius: 9px; background: #27151a; }.run-console__eyebrow, .run-console__next span { display: block; color: #e69494; font-size: .72rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }.run-console__cue h2 { margin: 7px 0 5px; color: #fff; font-size: 1.45rem; }.run-console__cue p { color: #bdc6d4; font-size: .86rem; }.run-console__next { align-self: center; }.run-console__next strong { display: block; margin-top: 6px; color: #edf4ff; line-height: 1.35; }.run-console__actions { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.4fr 1fr; gap: 10px; }.run-console__actions button { min-height: 52px; border: 1px solid #4d596b; border-radius: 7px; background: #202a38; color: #eef6ff; cursor: pointer; font-weight: 750; }.run-console__actions .run-console__go { border-color: #d85a5a; background: #ad353c; font-size: 1.08rem; }.run-console__actions button:disabled { cursor: not-allowed; opacity: .45; }.run-console__list { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 7px; }.run-console__list button { display: flex; gap: 7px; padding: 7px 9px; border: 1px solid #3c4657; border-radius: 5px; background: #141b27; color: #b9c7da; cursor: pointer; font-size: .78rem; }.run-console__list button.active { border-color: #ed8a8a; color: #fff; background: #4a2329; }.run-console__list button:disabled { opacity: .42; }.run-console__list span { color: #8fa0b7; }
.run-console__failure { grid-column: 1 / -1; display: grid; gap: 6px; padding: 15px; border: 1px solid #db5b62; border-radius: 8px; background: #421c22; color: #ffd7d9; }.run-console__failure strong { font-size: .78rem; letter-spacing: .08em; }.run-console__failure span { font-size: .86rem; }.run-console__failure button { justify-self: start; margin-top: 4px; border: 1px solid #e77b80; border-radius: 5px; padding: 7px 9px; background: transparent; color: #fff0f0; cursor: pointer; }
.run-console__session-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px solid #4c2930; padding-top: 14px; }.run-console__session-actions button { border: 1px solid #5a6678; border-radius: 5px; padding: 8px 10px; background: transparent; color: #cbd8e8; cursor: pointer; font-size: .78rem; }.confirmation-backdrop { position: fixed; z-index: 10; inset: 0; display: grid; place-items: center; padding: 18px; background: rgba(2, 5, 10, .72); }.confirmation-dialog { width: min(460px, 100%); padding: 22px; border: 1px solid #8c4a4f; border-radius: 11px; background: #1d151a; box-shadow: 0 20px 60px rgba(0,0,0,.5); }.confirmation-dialog h2 { margin: 0 0 10px; color: #fff; font-size: 1.15rem; }.confirmation-dialog p { color: #c3cedd; line-height: 1.45; }.confirmation-dialog div { display: flex; justify-content: flex-end; gap: 9px; margin-top: 18px; }.confirmation-dialog button { border: 1px solid #4f5d70; border-radius: 6px; padding: 9px 12px; background: #202a38; color: #eff6ff; cursor: pointer; }.confirmation-dialog .danger { border-color: #d35c5c; background: #a43239; }

.header h1 {
  font-size: 1.4rem;
  font-weight: 600;
  margin-bottom: 20px;
  border-bottom: 1px solid #333;
  padding-bottom: 12px;
}

.header p, .hint { color: #8490a2; font-size: .85rem; line-height: 1.45; }
.header p { margin-top: -10px; margin-bottom: 24px; }
.connection { display: inline-block; margin: -14px 0 16px!important; padding: 4px 8px; border: 1px solid #45536a; border-radius: 999px; font-size: .72rem!important; text-transform: capitalize; }.connection--connected { border-color: #2f8158; color: #9be5b6!important; }.connection--offline { border-color: #9d4040; color: #ffb3b3!important; }.connection--checking { color: #d4b66a!important; }
.mode-toggle { margin: -12px 0 20px; padding: 7px 10px; border: 1px solid #7b3c3c; border-radius: 5px; background: #2c1518; color: #ffc7c7; cursor: pointer; font-size: .78rem; }.mode-toggle.rehearsal { border-color: #8c7028; background: #2c2615; color: #ffe3a0; }
.cue-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.cue-grid button { padding: 12px; border: 1px solid #315477; border-radius: 6px; background: #142238; color: #d9efff; cursor: pointer; font-weight: 650; }
.cue-grid button:hover { background: #1a3150; }.cue-grid .safe-clear { border-color: #8e3939; background: #35191c; color: #ffc6c6; }.cue-grid .safe-clear:hover { background: #522326; }
.hint { margin: 10px 0 0; }
.diagnostics-panel { margin: 24px 0; padding: 16px; border: 1px dashed #4c5a6d; border-radius: 9px; background: #101722; }.diagnostics-panel > p { margin-bottom: 14px; color: #9aaabe; font-size: .82rem; }
.productions-home > .workspace-heading { margin-bottom: 16px; }.production-cards { display: grid; gap: 12px; }.production-card { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 18px; border: 1px solid #334155; border-radius: 10px; background: #121a26; }.production-card h3 { margin: 7px 0 5px; color: #f3f8ff; font-size: 1.1rem; }.production-card p { color: #aebbd0; font-size: .86rem; }.production-card__status { display: inline-flex; align-items: center; gap: 5px; border: 1px solid #516278; border-radius: 999px; padding: 3px 7px; color: #c5d1e1; font-size: .68rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }.production-card__status--live { border-color: #c9555b; color: #ffb3b7; }.production-card__status--rehearsal { border-color: #b78c32; color: #ffe09a; }.production-card__status--draft { border-color: #516278; color: #c5d1e1; }.production-card__actions { display: flex; flex-wrap: wrap; gap: 8px; }.production-card__actions button, .productions-empty button { border: 1px solid #4d6584; border-radius: 6px; padding: 8px 11px; background: #1d3048; color: #eaf5ff; cursor: pointer; font-weight: 700; }.production-card__actions button + button { background: transparent; color: #b7c6d9; }.productions-empty { padding: 28px; border: 1px dashed #465a75; border-radius: 10px; background: #101824; }.productions-empty h3 { color: #eff7ff; }.productions-empty p { margin: 8px 0 16px; color: #aebbd0; }
.prepare-overview { display: grid; grid-template-columns: minmax(0, 1fr) minmax(250px, .62fr); gap: 18px; }.readiness-panel { padding: 17px; border: 1px solid #3b4c63; border-radius: 10px; background: #111a27; }.readiness-panel h2 { color: #dbe8f8; }.readiness-panel ul { display: grid; gap: 10px; margin: 0 0 18px; padding: 0; list-style: none; }.readiness-panel li { padding-left: 20px; color: #aebdd0; font-size: .85rem; }.readiness-panel li::before { position: absolute; margin-left: -20px; font-weight: 900; }.readiness-panel li.ready { color: #a6e7bf; }.readiness-panel li.ready::before { content: "✓"; }.readiness-panel li.attention { color: #f1c97c; }.readiness-panel li.attention::before { content: "!"; }.readiness-panel button { border: 1px solid #5074a0; border-radius: 6px; padding: 9px 12px; background: #23466e; color: #eff8ff; cursor: pointer; font-weight: 750; }.readiness-panel button:disabled { cursor: not-allowed; opacity: .45; }
.elements-panel { padding: 15px; border: 1px solid #344a66; border-radius: 10px; background: #111a27; }.elements-panel .workspace-heading { align-items: center; }.elements-panel .workspace-heading h2 { margin-bottom: 4px; }.elements-panel__toggle { border: 1px solid #4f6685; border-radius: 6px; padding: 7px 10px; background: transparent; color: #cfe2fa; cursor: pointer; font-weight: 700; font-size: .78rem; }.elements-panel--collapsed { padding-bottom: 10px; }
.placement-zones { margin-top: 12px; padding-top: 12px; border-top: 1px solid #2d415b; }.placement-zones > span { display: block; margin-bottom: 8px; color: #94a9c0; font-size: .76rem; }.placement-zones > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px; }.placement-zones button { min-height: 34px; border: 1px dashed #496888; border-radius: 5px; background: #0d1724; color: #bfd2e8; cursor: copy; font-size: .72rem; text-transform: capitalize; }.placement-zones button:hover, .placement-zones button:focus-visible { border-style: solid; border-color: #73e3ff; background: #17324d; outline: none; }
.control-surface { padding: 16px; border: 1px solid #36526f; border-radius: 10px; background: #101a27; }.control-surface .workspace-heading { margin-bottom: 14px; }.control-surface__mode { display: flex; gap: 5px; padding: 4px; border: 1px solid #344b68; border-radius: 7px; background: #0c1420; }.control-surface__mode button { border: 0; border-radius: 5px; padding: 6px 8px; background: transparent; color: #9eb0c6; cursor: pointer; font-size: .72rem; }.control-surface__mode button.active { background: #315678; color: #f0f8ff; font-weight: 800; }.control-surface__macros { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #293e58; }.control-surface__macros span { color: #93a8bf; font-size: .75rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }.control-surface__macros button { border: 1px solid #405d7f; border-radius: 5px; padding: 7px 9px; background: #1b3048; color: #e7f2ff; cursor: pointer; font-size: .76rem; font-weight: 700; }

/* Prepare → Rundown is the production-building frame: cue list, selected-cue
   editor, then the real audience preview. Elements stay secondary tooling. */
.workspace--prepare-rundown { display: grid; grid-template-columns: minmax(210px, .72fr) minmax(260px, 1fr) minmax(330px, 1.35fr); grid-template-areas: "header header header" "nav nav nav" "context context context" "rundown editor preview"; column-gap: 14px; align-items: start; max-width: 1540px; }.workspace--prepare-rundown > .admin-shell__header { grid-area: header; }.workspace--prepare-rundown > .admin-shell__nav { grid-area: nav; }.workspace--prepare-rundown > .admin-context { grid-area: context; }.workspace--prepare-rundown > .studio-preview { grid-area: preview; margin: 0; min-width: 0; padding: 14px; border: 1px solid #36526f; border-radius: 10px; background: #101a27; }.workspace--prepare-rundown > .studio-preview .player-preview { min-height: 360px; margin-top: 10px; }.workspace--prepare-rundown > .rundown-editor { grid-area: rundown; margin: 0; max-height: calc(100vh - 185px); overflow: auto; padding: 14px; border: 1px solid #3a4a60; border-radius: 10px; background: #111925; }.workspace--prepare-rundown > .rundown-editor h2 { margin-bottom: 10px; }.workspace--prepare-rundown > .rundown-editor .form { gap: 7px; }.workspace--prepare-rundown > .rundown-editor .cue-grid { grid-template-columns: minmax(0, 1fr) 1fr; padding: 9px 0; border-top: 1px solid #293849; }.workspace--prepare-rundown > .rundown-editor .cue-grid strong { grid-column: 1 / -1; }.workspace--prepare-rundown > .control-surface { grid-area: editor; margin: 0; min-height: 520px; }.workspace--prepare-rundown > .legacy-overlay { grid-column: 1 / -1; }.workspace--prepare-rundown > .prepare-content { display: none; }
@media (max-width: 980px) { .workspace--prepare-rundown { display: block; }.workspace--prepare-rundown > .elements-panel, .workspace--prepare-rundown > .studio-preview, .workspace--prepare-rundown > .rundown-editor, .workspace--prepare-rundown > .control-surface { margin: 16px 0; position: static; max-height: none; }.workspace--prepare-rundown > .studio-preview .player-preview { min-height: 300px; } }

/* Prepare → Configuration: elements panel (LEFT) + config form (CENTRE) */
.workspace--prepare-config { display: grid; grid-template-columns: minmax(210px, .72fr) 1fr; column-gap: 14px; align-items: start; max-width: 1540px; }
.workspace--prepare-config > .elements-panel { margin: 0; }
.workspace--prepare-config > .prepare-content { margin: 0; }
.workspace--prepare-config > .studio-preview { grid-column: 1 / -1; margin: 14px 0 0; }
.workspace--prepare-config > .control-surface { grid-column: 1 / -1; margin-top: 14px; }
.workspace--prepare-config > .legacy-overlay { grid-column: 1 / -1; }
@media (max-width: 980px) { .workspace--prepare-config { display: block; }.workspace--prepare-config > .elements-panel, .workspace--prepare-config > .prepare-content { margin: 16px 0; } }

/* Rehearse: quick-cues (LEFT) | console (CENTRE) | preview (RIGHT) */
.workspace--rehearse { display: grid; grid-template-columns: minmax(200px, .65fr) minmax(260px, 1fr) minmax(300px, 1.2fr); column-gap: 14px; align-items: start; max-width: 1540px; }
.workspace--rehearse > .quick-cues { margin: 0; }
.workspace--rehearse > .rehearsal-console { margin: 0; }
.workspace--rehearse > .rehearsal-preview { margin: 0; }
.workspace--rehearse > .control-surface { grid-column: 1 / -1; margin-top: 14px; }
.workspace--rehearse > .status-msg, .workspace--rehearse > .error-msg { grid-column: 1 / -1; }
@media (max-width: 980px) { .workspace--rehearse { display: block; }.workspace--rehearse > .quick-cues, .workspace--rehearse > .rehearsal-console, .workspace--rehearse > .rehearsal-preview { margin: 16px 0; } }

/* Run: run-console (LEFT/CENTRE) | programme preview (RIGHT) when active */
.workspace--run { display: grid; grid-template-columns: 1fr minmax(330px, 1.2fr); column-gap: 14px; align-items: start; max-width: 1540px; }
.workspace--run > .run-entry { grid-column: 1 / -1; }
.workspace--run > .run-preview { margin: 0; }
.workspace--run > .run-console { margin: 0; }
.workspace--run > .status-msg, .workspace--run > .error-msg { grid-column: 1 / -1; }
@media (max-width: 980px) { .workspace--run { display: block; }.workspace--run > .run-preview, .workspace--run > .run-console { margin: 16px 0; } }

/* Pipeline status */
.pipeline-status {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  font-size: 0.95rem;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.dot.connected {
  background: #22c55e;
  box-shadow: 0 0 6px #22c55e;
}

.dot.disconnected {
  background: #ef4444;
  box-shadow: 0 0 6px #ef4444;
}

/* Sections */
.section {
  margin-bottom: 32px;
}

.section h2 {
  font-size: 1.05rem;
  font-weight: 600;
  margin-bottom: 12px;
  color: #aaa;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

/* Form */
.form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 0.9rem;
  color: #aaa;
}

.form input {
  padding: 8px 10px;
  border: 1px solid #333;
  border-radius: 4px;
  background: #1a1a1a;
  color: #e0e0e0;
  font-size: 0.95rem;
}
.form select { padding: 8px 10px; border: 1px solid #333; border-radius: 4px; background: #1a1a1a; color: #e0e0e0; font-size: .95rem; }
.panel-options { display: flex; flex-wrap: wrap; gap: 8px 14px; border: 1px solid #334155; border-radius: 6px; padding: 10px; color: #b6c3d4; }.panel-options legend { padding: 0 4px; color: #aab8ca; font-size: .82rem; }.panel-options label { display: flex; align-items: center; gap: 5px; text-transform: capitalize; }.panel-options input { accent-color: #73e3ff; }

.form input:focus {
  outline: none;
  border-color: #555;
}

.form button {
  align-self: flex-start;
  margin-top: 4px;
  padding: 8px 20px;
  border: none;
  border-radius: 4px;
  background: #3b82f6;
  color: #fff;
  font-size: 0.95rem;
  cursor: pointer;
  transition: background 0.15s;
}

.form button:hover {
  background: #2563eb;
}

.form button:active {
  background: #1d4ed8;
}

/* Status / error messages */
.status-msg {
  margin-top: 10px;
  font-size: 0.9rem;
  color: #22c55e;
}

.error-msg {
  margin-top: 10px;
  font-size: 0.9rem;
  color: #ef4444;
}

/* Events table */
.empty {
  color: #666;
  font-size: 0.9rem;
}

.events-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.events-table th {
  text-align: left;
  padding: 8px 10px;
  border-bottom: 1px solid #333;
  color: #888;
  font-weight: 500;
}

.events-table td {
  padding: 8px 10px;
  border-bottom: 1px solid #222;
}

.events-table .mono {
  font-family: "SF Mono", "Fira Code", monospace;
  font-size: 0.85rem;
  color: #999;
}
button:focus-visible, input:focus-visible, select:focus-visible, a:focus-visible { outline: 3px solid #73e3ff; outline-offset: 2px; }
@media (max-width: 720px) { .admin-shell__header, .workspace-heading { flex-direction: column; }.admin-shell__nav { overflow-x: auto; }.admin-shell__nav button { min-width: 110px; }.admin-context .form, .run-entry__summary, .run-console { grid-template-columns: 1fr; }.player-preview { min-height: 280px; } }

/* ── Three-column workspace grid system ──────────────────────────────────────── */
/* Consistent layout primitive: LEFT (selection) | CENTRE (work) | RIGHT (verify) */

.workspace-grid {
  display: grid;
  grid-template-columns: minmax(220px, 22%) minmax(420px, 48%) minmax(300px, 30%);
  gap: 14px;
  align-items: start;
  width: 100%;
  max-width: 1540px;
}

.workspace-grid--wide-centre {
  grid-template-columns: minmax(220px, 18%) minmax(420px, 52%) minmax(300px, 30%);
}

.workspace-grid__left {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.workspace-grid__centre {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.workspace-grid__right {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Medium: RIGHT below CENTRE */
@media (max-width: 1100px) and (min-width: 721px) {
  .workspace-grid {
    grid-template-columns: minmax(220px, 30%) 1fr;
    grid-template-areas:
      "left centre"
      "right right";
  }
  .workspace-grid__left { grid-area: left; }
  .workspace-grid__centre { grid-area: centre; }
  .workspace-grid__right { grid-area: right; }
}

/* Narrow: stacked */
@media (max-width: 720px) {
  .workspace-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
}

/* ── Workspace panel styles ─────────────────────────────────────────────────── */

.workspace-panel {
  padding: 16px;
  border: 1px solid #2a3445;
  border-radius: 10px;
  background: #121a26;
}

.workspace-panel--readiness {
  background: #111a27;
  border-color: #3b4c63;
}

.workspace-panel--preview {
  background: #101a27;
  border-color: #36526f;
}

.workspace-panel--control {
  background: #101a27;
  border-color: #36526f;
}

.workspace-panel--rehearse {
  background: #1e1a11;
  border-color: #8c7028;
}

.workspace-panel--run {
  background: #180e11;
  border-color: #7b3c3c;
}

.workspace-panel__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 14px;
}

.workspace-panel__heading {
  color: #dbe8f8;
  font-size: 1rem;
  font-weight: 650;
}

.workspace-panel__hint {
  color: #8490a2;
  font-size: .82rem;
  line-height: 1.45;
  margin-top: 4px;
}

/* ── Status badge styles ────────────────────────────────────────────────────── */

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: 1px solid #516278;
  border-radius: 999px;
  padding: 3px 7px;
  font-size: .68rem;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.status-badge__icon {
  font-size: .72rem;
}

.status-badge--live,
.status-badge--active {
  border-color: #c9555b;
  color: #ffb3b7;
}

.status-badge--rehearsal {
  border-color: #b78c32;
  color: #ffe09a;
}

.status-badge--draft,
.status-badge--pending {
  border-color: #516278;
  color: #c5d1e1;
}

.status-badge--complete,
.status-badge--dispatched {
  border-color: #2f8158;
  color: #9be5b6;
}

.status-badge--failed {
  border-color: #d35c5c;
  color: #ffb3b3;
}

.status-badge--cancelled,
.status-badge--archived {
  border-color: #4f5e72;
  color: #8490a2;
}

/* ── Connection badge styles ────────────────────────────────────────────────── */

.connection-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  border: 1px solid #45536a;
  border-radius: 999px;
  font-size: .72rem;
  text-transform: capitalize;
}

.connection-badge__icon {
  font-size: .68rem;
}

.connection-badge--connected {
  border-color: #2f8158;
  color: #9be5b6;
}

.connection-badge--offline {
  border-color: #9d4040;
  color: #ffb3b3;
}

.connection-badge--checking {
  border-color: #b78c32;
  color: #d4b66a;
}

/* ── Empty state styles ─────────────────────────────────────────────────────── */

.empty-state {
  padding: 28px;
  border: 1px dashed #465a75;
  border-radius: 10px;
  background: #101824;
  text-align: center;
}

.empty-state__heading {
  color: #eff7ff;
  font-size: 1rem;
  margin-bottom: 8px;
}

.empty-state__description {
  color: #aebbd0;
  font-size: .86rem;
  margin-bottom: 16px;
}

.empty-state__action {
  margin-top: 16px;
}

/* ── Validation message styles ──────────────────────────────────────────────── */

.validation-message {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: .85rem;
}

.validation-message__icon {
  font-weight: 800;
}

.validation-message--error {
  background: #421c22;
  border: 1px solid #db5b62;
  color: #ffd7d9;
}

.validation-message--success {
  background: #0f261a;
  border: 1px solid #2f8158;
  color: #9be5b6;
}

.validation-message--warning {
  background: #2a210f;
  border: 1px solid #b78c32;
  color: #ffe2a2;
}

.validation-message--info {
  background: #0f1a27;
  border: 1px solid #3b4c63;
  color: #aebdd0;
}

/* ── Action button styles ───────────────────────────────────────────────────── */

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 9px 16px;
  border: 1px solid #4d596b;
  border-radius: 7px;
  background: #202a38;
  color: #eef6ff;
  cursor: pointer;
  font-weight: 700;
  font-size: .85rem;
  min-height: 40px;
  transition: background 0.15s, border-color 0.15s;
}

.action-btn:disabled {
  cursor: not-allowed;
  opacity: .45;
}

.action-btn__icon {
  font-size: .9rem;
}

.action-btn--primary {
  border-color: #3b82f6;
  background: #3b82f6;
  color: #fff;
  font-size: .95rem;
}

.action-btn--primary:hover:not(:disabled) {
  background: #2563eb;
}

.action-btn--secondary {
  border-color: #4d6584;
  background: transparent;
  color: #b7c6d9;
}

.action-btn--secondary:hover:not(:disabled) {
  background: #1d3048;
  color: #eaf5ff;
}

.action-btn--danger {
  border-color: #d35c5c;
  background: #a43239;
  color: #fff;
}

.action-btn--danger:hover:not(:disabled) {
  background: #8b2a30;
}

.action-btn--safety {
  border-color: #8e3939;
  background: #35191c;
  color: #ffc6c6;
}

.action-btn--safety:hover:not(:disabled) {
  background: #522326;
}

/* Large variant for GO button */
.action-btn--go {
  min-height: 64px;
  padding: 14px 28px;
  border-color: #d85a5a;
  background: #ad353c;
  font-size: 1.15rem;
  font-weight: 800;
}

/* ── Cue list styles ────────────────────────────────────────────────────────── */

.cue-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cue-list__heading {
  color: #dbe8f8;
  font-size: .9rem;
  font-weight: 650;
  margin-bottom: 8px;
}

.cue-list__items {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cue-list-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  transition: background 0.1s, border-color 0.1s;
}

.cue-list-item:hover {
  background: rgba(255, 255, 255, .03);
}

.cue-list-item--active {
  background: #1d3048;
  border-color: #3b82f6;
}

.cue-list-item--disabled {
  opacity: .45;
}

.cue-list-item__select {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 0;
  background: transparent;
  color: #eef6ff;
  cursor: pointer;
  text-align: left;
  padding: 0;
  width: 100%;
  font-size: .85rem;
}

.cue-list-item__select:disabled {
  cursor: not-allowed;
  opacity: .6;
}

.cue-list-item__order {
  color: #8490a2;
  font-weight: 650;
  min-width: 28px;
}

.cue-list-item__label {
  flex: 1;
  font-weight: 650;
}

.cue-list-item__status {
  font-size: .72rem;
  text-transform: capitalize;
  padding: 2px 6px;
  border-radius: 4px;
  background: #1a2333;
  color: #8490a2;
}

.cue-list-item__status--active {
  background: #2a210f;
  color: #ffe09a;
}

.cue-list-item__status--complete {
  background: #0f261a;
  color: #9be5b6;
}

.cue-list-item__status--failed {
  background: #421c22;
  color: #ffd7d9;
}

.cue-list-item__actions {
  display: flex;
  gap: 6px;
  padding-left: 36px;
}

.cue-list-item__actions button {
  padding: 4px 8px;
  border: 1px solid #3c4657;
  border-radius: 4px;
  background: #141b27;
  color: #b9c7da;
  cursor: pointer;
  font-size: .72rem;
}

.cue-list-item__actions button:hover:not(:disabled) {
  background: #1d3048;
  color: #eef6ff;
}

.cue-list-item__actions button:disabled {
  opacity: .42;
  cursor: not-allowed;
}

/* ── Prepare navigation styles ─────────────────────────────────────────────── */

.prepare-nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.prepare-nav__item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: #9fb0c5;
  cursor: pointer;
  font-size: .85rem;
  font-weight: 600;
  text-align: left;
  transition: background 0.1s, border-color 0.1s, color 0.1s;
}

.prepare-nav__item:hover {
  background: rgba(255, 255, 255, .03);
  color: #eef6ff;
}

.prepare-nav__item--active {
  background: #273d5b;
  border-color: #3b82f6;
  color: #eff8ff;
  font-weight: 750;
}
