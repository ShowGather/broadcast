{
  "name": "showgather-broadcast",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @showgather/api dev",
    "dev:admin": "pnpm --filter @showgather/admin dev",
    "dev:player": "pnpm --filter @showgather/player dev",
    "build": "pnpm --filter @showgather/event-schema build && pnpm --filter @showgather/id3 build && pnpm --filter @showgather/presentation-model build && pnpm --filter @showgather/api build && pnpm --filter @showgather/admin build && pnpm --filter @showgather/player build",
    "typecheck": "pnpm -r run typecheck",
    "stream": "bash stream/scripts/generate-test-stream.sh",
    "verify": "bash stream/scripts/verify-segments.sh",
    "pilot:up": "docker compose --env-file .env -f deploy/compose/docker-compose.yml up --build -d",
    "pilot:down": "docker compose --env-file .env -f deploy/compose/docker-compose.yml down",
    "db:generate": "pnpm --filter @showgather/api db:generate",
    "db:migrate": "pnpm --filter @showgather/api db:migrate",
    "db:deploy": "pnpm --filter @showgather/api db:deploy",
    "db:seed": "pnpm --filter @showgather/api db:seed",
    "db:reset": "pnpm --filter @showgather/api db:reset"
  }
}
